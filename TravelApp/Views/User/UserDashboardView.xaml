<UserControl x:Class="TravelApp.Views.User.UserDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="20">
        <TabControl Style="{StaticResource MaterialDesignTabControl}">
            <TabItem Header="KHÁM PHÁ &amp; ĐẶT TOUR">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" DataContext="{Binding SearchVM}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="Tìm hành trình"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Lọc điểm đến theo khu vực, giá, đánh giá và Guide."
                                       Foreground="Gray"
                                       Margin="0,4,0,12"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding SearchProvince, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Tỉnh/Thành phố"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchMaxPrice, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Giá tối đa"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Margin="0,0,10,0"/>
                            <TextBox Grid.Column="2"
                                     Text="{Binding SearchMinRating, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Đánh giá tối thiểu"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Margin="0,0,10,0"/>
                            <TextBox Grid.Column="3"
                                     Text="{Binding SearchGuideName, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Tên Guide"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Margin="0,0,10,0"/>
                            <TextBox Grid.Column="4"
                                     Text="{Binding SearchTime, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Ngày/khung giờ"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Margin="0,0,10,0"/>
                            <Button Grid.Column="5"
                                    Command="{Binding SearchCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Height="40"
                                    MinWidth="110">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Magnify"
                                                             Margin="0,0,8,0"/>
                                    <TextBlock Text="Tìm kiếm"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="1"
                          DataContext="{Binding SearchVM}"
                          Margin="0,18,0,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <GroupBox Grid.Row="0"
                                      Grid.Column="0"
                                      Header="Điểm đến"
                                      Margin="0,0,6,0">
                                <DataGrid ItemsSource="{Binding DestinationResults}"
                                          SelectedItem="{Binding DataContext.BookingVM.SelectedDestination, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tên"
                                                            Binding="{Binding Name}"
                                                            Width="*"/>
                                        <DataGridTextColumn Header="Khu vực"
                                                            Binding="{Binding Country}"
                                                            Width="*"/>
                                        <DataGridTextColumn Header="Đánh giá"
                                                            Binding="{Binding AverageRating}"
                                                            Width="75"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>

                            <GroupBox Grid.Row="0"
                                      Grid.Column="1"
                                      Header="Khách sạn"
                                      Margin="6,0">
                                <DataGrid ItemsSource="{Binding HotelResults}"
                                          SelectedItem="{Binding DataContext.BookingVM.SelectedHotel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tên"
                                                            Binding="{Binding Name}"
                                                            Width="*"/>
                                        <DataGridTextColumn Header="Giá/đêm"
                                                            Binding="{Binding PricePerNight, StringFormat={}{0:N0}}"
                                                            Width="90"/>
                                        <DataGridTextColumn Header="Sao"
                                                            Binding="{Binding Rating}"
                                                            Width="45"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>

                            <GroupBox Grid.Row="0"
                                      Grid.Column="2"
                                      Header="Guide"
                                      Margin="6,0,0,0">
                                <DataGrid ItemsSource="{Binding GuideResults}"
                                          SelectedItem="{Binding DataContext.BookingVM.SelectedGuide, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Họ tên"
                                                            Binding="{Binding FullName}"
                                                            Width="*"/>
                                        <DataGridTextColumn Header="Email"
                                                            Binding="{Binding Email}"
                                                            Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>

                            <TextBlock Grid.Row="1"
                                       Grid.ColumnSpan="3"
                                       Text="{Binding SearchMessage}"
                                       Foreground="Gray"
                                       Margin="0,8,0,0"/>

                            <ProgressBar Grid.Row="0"
                                         Grid.ColumnSpan="3"
                                         IsIndeterminate="True"
                                         Height="3"
                                         VerticalAlignment="Top"
                                         Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    DataContext="{Binding BookingVM}"
                                    Margin="0,0,20,0">
                            <TextBlock Text="Yêu cầu đặt tour"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedDestination.Name, StringFormat=Điểm đến đã chọn: {0}, TargetNullValue=Chưa chọn điểm đến}"
                                       Margin="0,8,0,8"/>
                            <TextBlock Text="{Binding SelectedHotel.Name, StringFormat=Khách sạn đã chọn: {0}, TargetNullValue=Chưa chọn khách sạn}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedGuide.FullName, StringFormat=Guide đã chọn: {0}, TargetNullValue=Chưa chọn Guide}"
                                       Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <DatePicker SelectedDate="{Binding StartDate}"
                                            materialDesign:HintAssist.Hint="Ngày khởi hành"
                                            Width="150"
                                            Margin="0,0,10,0"/>
                                <TextBox Text="{Binding TripDurationDays, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Số ngày"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         Width="120"
                                         Margin="0,0,10,0"/>
                                <Button Content="Gửi yêu cầu"
                                        Command="{Binding SubmitBookingCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Height="40"/>
                            </StackPanel>
                            <TextBlock Text="{Binding BookingMessage}"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    DataContext="{Binding PaymentVM}">
                            <TextBlock Text="Thanh toán mô phỏng"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,8,0,6">
                                <Button Command="{Binding ProcessFakeQRPaymentCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        ToolTip="Mô phỏng thanh toán QR"
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Qrcode"
                                                                 Margin="0,0,8,0"/>
                                        <TextBlock Text="QR"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ProcessBankTransferCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="BankTransfer"
                                                                 Margin="0,0,8,0"/>
                                        <TextBlock Text="Chuyển khoản"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding PaymentMethod, StringFormat=Phương thức: {0}, TargetNullValue=Chưa thanh toán}"
                                       Foreground="Gray"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="BOOKING CỦA TÔI">
                <Grid Margin="16"
                      DataContext="{Binding BookingVM}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0"
                               Margin="0,0,0,12">
                        <TextBlock Text="Danh sách booking của tôi"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Content="Làm mới"
                                Command="{Binding LoadBookingsCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                DockPanel.Dock="Right"
                                HorizontalAlignment="Right"/>
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Bookings}"
                              SelectedItem="{Binding SelectedBooking}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã booking"
                                                Binding="{Binding BookingId}"
                                                Width="130"/>
                            <DataGridTextColumn Header="Điểm đến"
                                                Binding="{Binding Destination.Name}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Guide"
                                                Binding="{Binding Guide.FullName}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Khách sạn"
                                                Binding="{Binding Hotel.Name, TargetNullValue=Không chọn}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Khởi hành"
                                                Binding="{Binding StartDate, StringFormat={}{0:dd/MM/yyyy}}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Số ngày"
                                                Binding="{Binding Nights}"
                                                Width="70"/>
                            <DataGridTextColumn Header="Tổng tiền"
                                                Binding="{Binding Price, StringFormat={}{0:N0}}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Trạng thái"
                                                Binding="{Binding Status}"
                                                Width="90"/>
                            <DataGridTemplateColumn Header="Thao tác"
                                                    Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Hủy"
                                                Command="{Binding DataContext.CancelBookingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <ProgressBar Grid.Row="1"
                                 IsIndeterminate="True"
                                 Height="3"
                                 VerticalAlignment="Top"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </TabItem>

            <TabItem Header="YÊU THÍCH &amp; ĐÁNH GIÁ">
                <Grid Margin="16">
                    <TextBlock Text="Quản lý danh sách Yêu thích và Đánh giá Guide/Khách sạn"
                               FontSize="16"/>
                </Grid>
            </TabItem>

            <TabItem Header="HỒ SƠ CỦA TÔI">
                <Grid Margin="16">
                    <TextBlock Text="Chỉnh sửa thông tin cá nhân"
                               FontSize="16"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
