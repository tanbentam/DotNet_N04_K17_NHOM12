<UserControl x:Class="TravelApp.Views.Admin.ContentManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <ProgressBar IsIndeterminate="True" Height="4"
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                       TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
            <TextBlock Text="{Binding SuccessMessage}" Foreground="Green"
                       TextWrapping="Wrap"
                       Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <TabControl Grid.Row="1" Style="{StaticResource MaterialDesignTabControl}">
            <TabItem Header="DESTINATIONS">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                    Margin="0,0,0,12">
                            <Button Content="+ Create Destination"
                                    Command="{Binding CreateDestinationCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Refresh"
                                    Command="{Binding LoadContentDataCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Destinations}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  materialDesign:DataGridAssist.CellPadding="10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Country" Binding="{Binding Country}" Width="150"/>
                                <DataGridTextColumn Header="Rating" Binding="{Binding AverageRating}" Width="80"/>
                                <DataGridTextColumn Header="Created by" Binding="{Binding CreatedByGuide.FullName}" Width="130"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding ApprovalStatus}" Width="90"/>
                                <DataGridTemplateColumn Header="Actions" Width="260">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Edit"
                                                        Command="{Binding DataContext.EditDestinationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Padding="0"/>
                                                <Button Content="Approve"
                                                        Command="{Binding DataContext.ApproveDestinationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Foreground="Green" Padding="0" Margin="8,0,0,0"/>
                                                <Button Content="Reject"
                                                        Command="{Binding DataContext.RejectDestinationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Foreground="DarkOrange" Padding="0" Margin="8,0,0,0"/>
                                                <Button Content="Delete"
                                                        Command="{Binding DataContext.DeleteDestinationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Foreground="Red" Padding="0" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <materialDesign:Card Grid.Column="1" Width="330" Padding="20"
                                         Margin="20,0,0,0" VerticalAlignment="Top"
                                         Visibility="{Binding IsDestinationEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding DestinationFormTitle}"
                                       FontSize="20" FontWeight="SemiBold"
                                       Margin="0,0,0,16"/>
                            <TextBox Text="{Binding DestinationName, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Name"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Margin="0,0,0,10"/>
                            <TextBox Text="{Binding DestinationCountry, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Country"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Margin="0,0,0,10"/>
                            <TextBox Text="{Binding DestinationDescription, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Description"
                                     AcceptsReturn="True" Height="70"
                                     TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Border Height="90" Background="#FFF2F2F2"
                                    BorderBrush="#FFDDDDDD" BorderThickness="1"
                                    CornerRadius="4" Margin="0,0,0,8">
                                <Image Source="{Binding DestinationImageUrl}"
                                       Stretch="Uniform"/>
                            </Border>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding DestinationImageUrl, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Image URL or local path"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="Choose"
                                        Command="{Binding SelectDestinationImageCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
                            </Grid>
                            <TextBox Text="{Binding DestinationRating, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Rating (0 - 9.99)"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Margin="0,0,0,16"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel"
                                        Command="{Binding CancelDestinationEditCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="0,0,8,0"/>
                                <Button Content="Save"
                                        Command="{Binding SaveDestinationCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <TabItem Header="HOTELS">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                    Margin="0,0,0,12">
                            <Button Content="+ Create Hotel"
                                    Command="{Binding CreateHotelCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Refresh"
                                    Command="{Binding LoadContentDataCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Hotels}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  materialDesign:DataGridAssist.CellPadding="10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Destination" Binding="{Binding Destination.Name}" Width="150"/>
                                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*"/>
                                <DataGridTextColumn Header="Price/Night" Binding="{Binding PricePerNight}" Width="100"/>
                                <DataGridTextColumn Header="Rating" Binding="{Binding Rating}" Width="70"/>
                                <DataGridTextColumn Header="Created by" Binding="{Binding CreatedByGuide.FullName}" Width="130"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding ApprovalStatus}" Width="90"/>
                                <DataGridTemplateColumn Header="Actions" Width="260">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Edit"
                                                        Command="{Binding DataContext.EditHotelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Padding="0"/>
                                                <Button Content="Approve"
                                                        Command="{Binding DataContext.ApproveHotelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Foreground="Green" Padding="0" Margin="8,0,0,0"/>
                                                <Button Content="Reject"
                                                        Command="{Binding DataContext.RejectHotelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Foreground="DarkOrange" Padding="0" Margin="8,0,0,0"/>
                                                <Button Content="Delete"
                                                        Command="{Binding DataContext.DeleteHotelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Foreground="Red" Padding="0" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <materialDesign:Card Grid.Column="1" Width="350" Padding="20"
                                         Margin="20,0,0,0" VerticalAlignment="Top"
                                         Visibility="{Binding IsHotelEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding HotelFormTitle}"
                                       FontSize="20" FontWeight="SemiBold"
                                       Margin="0,0,0,16"/>
                            <ComboBox ItemsSource="{Binding Destinations}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding HotelDestinationId}"
                                      materialDesign:HintAssist.Hint="Destination"
                                      Margin="0,0,0,10"/>
                            <TextBox Text="{Binding HotelName, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Name"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Margin="0,0,0,10"/>
                            <TextBox Text="{Binding HotelAddress, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Address"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Margin="0,0,0,10"/>
                            <TextBox Text="{Binding HotelDescription, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Description"
                                     AcceptsReturn="True" Height="60"
                                     TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBox Text="{Binding HotelPricePerNight, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Price per night"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Margin="0,0,0,10"/>
                            <TextBox Text="{Binding HotelRating, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Rating (0 - 5)"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Margin="0,0,0,10"/>
                            <Border Height="90" Background="#FFF2F2F2"
                                    BorderBrush="#FFDDDDDD" BorderThickness="1"
                                    CornerRadius="4" Margin="0,0,0,8">
                                <Image Source="{Binding HotelImageUrl}"
                                       Stretch="Uniform"/>
                            </Border>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding HotelImageUrl, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Image URL or local path"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="Choose"
                                        Command="{Binding SelectHotelImageCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel"
                                        Command="{Binding CancelHotelEditCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="0,0,8,0"/>
                                <Button Content="Save"
                                        Command="{Binding SaveHotelCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <TabItem Header="BOOKINGS">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <Button DockPanel.Dock="Top" Content="Refresh"
                                Command="{Binding LoadContentDataCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <DataGrid ItemsSource="{Binding Bookings}"
                                  SelectedItem="{Binding SelectedBooking}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Booking ID" Binding="{Binding BookingId}" Width="110"/>
                                <DataGridTextColumn Header="User" Binding="{Binding User.FullName}" Width="*"/>
                                <DataGridTextColumn Header="Guide" Binding="{Binding Guide.FullName}" Width="*"/>
                                <DataGridTextColumn Header="Destination" Binding="{Binding Destination.Name}" Width="*"/>
                                <DataGridTextColumn Header="Hotel" Binding="{Binding Hotel.Name}" Width="*"/>
                                <DataGridTextColumn Header="Start date" Binding="{Binding StartDate, StringFormat=d}" Width="90"/>
                                <DataGridTextColumn Header="Nights" Binding="{Binding Nights}" Width="60"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N0}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <materialDesign:Card Grid.Column="1" Padding="20"
                                         Margin="20,0,0,0"
                                         VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Manage Booking"
                                       FontSize="20" FontWeight="SemiBold"
                                       Margin="0,0,0,16"/>
                            <TextBlock Text="Select a booking from the table."
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding SelectedBooking.BookingId}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedBooking.User.FullName}"
                                       Margin="0,0,0,12"/>
                            <ComboBox ItemsSource="{Binding BookingStatuses}"
                                      SelectedItem="{Binding SelectedBookingStatus}"
                                      materialDesign:HintAssist.Hint="New status"
                                      Margin="0,0,0,16"/>
                            <Button Content="Update Status"
                                    Command="{Binding SaveBookingStatusCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"/>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
