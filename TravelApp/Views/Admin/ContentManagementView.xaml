<UserControl x:Class="TravelApp.Views.Admin.ContentManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <ProgressBar IsIndeterminate="True" Height="4"
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                       TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
            <TextBlock Text="{Binding SuccessMessage}" Foreground="Green"
                       TextWrapping="Wrap"
                       Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <TabControl Grid.Row="1" Style="{StaticResource MaterialDesignTabControl}">
            <TabItem Header="ĐIỂM ĐẾN">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                    Margin="0,0,0,12">
                            <Button Content="+ Tạo điểm đến"
                                    Command="{Binding CreateDestinationCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Làm mới"
                                    Command="{Binding LoadContentDataCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Destinations}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  materialDesign:DataGridAssist.CellPadding="10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Quốc gia" Binding="{Binding Country}" Width="150"/>
                                <DataGridTextColumn Header="Đánh giá" Binding="{Binding AverageRating}" Width="80"/>
                                <DataGridTextColumn Header="Người tạo" Binding="{Binding CreatedByGuide.FullName}" Width="130"/>
                                <DataGridTextColumn Header="Trạng thái"
                                                    Binding="{Binding ApprovalStatus, Converter={StaticResource EnumToVietnameseConverter}}"
                                                    Width="100"/>
                                <DataGridTemplateColumn Header="Thao tác" Width="260">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Sửa"
                                                        Command="{Binding DataContext.EditDestinationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Padding="0"/>
                                                <Button Content="Duyệt"
                                                        Command="{Binding DataContext.ApproveDestinationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding ApprovalStatus,
                                                            Converter={StaticResource EnumNotEqualConverter},
                                                            ConverterParameter=Approved}"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Foreground="Green" Padding="0" Margin="8,0,0,0"/>
                                                <Button Content="Từ chối"
                                                        Command="{Binding DataContext.RejectDestinationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding ApprovalStatus,
                                                            Converter={StaticResource EnumNotEqualConverter},
                                                            ConverterParameter=Rejected}"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Foreground="DarkOrange" Padding="0" Margin="8,0,0,0"/>
                                                <Button Content="Xóa"
                                                        Command="{Binding DataContext.DeleteDestinationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Foreground="Red" Padding="0" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <materialDesign:Card Grid.Column="1" Width="330" Padding="20"
                                         Margin="20,0,0,0" VerticalAlignment="Top"
                                         Visibility="{Binding IsDestinationEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding DestinationFormTitle}"
                                       FontSize="20" FontWeight="SemiBold"
                                       Margin="0,0,0,16"/>
                            <TextBox Text="{Binding DestinationName, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Tên"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Margin="0,0,0,10"/>
                            <TextBox Text="{Binding DestinationCountry, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Quốc gia"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Margin="0,0,0,10"/>
                            <TextBox Text="{Binding DestinationDescription, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Mô tả"
                                     AcceptsReturn="True" Height="70"
                                     TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Border Height="90" Background="#FFF2F2F2"
                                    BorderBrush="#FFDDDDDD" BorderThickness="1"
                                    CornerRadius="4" Margin="0,0,0,8">
                                <Image Source="{Binding DestinationImageUrl}"
                                       Stretch="Uniform"/>
                            </Border>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding DestinationImageUrl, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="URL hoặc đường dẫn ảnh"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="Chọn"
                                        Command="{Binding SelectDestinationImageCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
                            </Grid>
                            <TextBox Text="{Binding DestinationRating, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Đánh giá (0 - 9,99)"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Margin="0,0,0,16"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Hủy"
                                        Command="{Binding CancelDestinationEditCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="0,0,8,0"/>
                                <Button Content="Lưu"
                                        Command="{Binding SaveDestinationCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <TabItem Header="KHÁCH SẠN">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                    Margin="0,0,0,12">
                            <Button Content="+ Tạo khách sạn"
                                    Command="{Binding CreateHotelCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Làm mới"
                                    Command="{Binding LoadContentDataCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Hotels}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  materialDesign:DataGridAssist.CellPadding="10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Điểm đến" Binding="{Binding Destination.Name}" Width="150"/>
                                <DataGridTextColumn Header="Địa chỉ" Binding="{Binding Address}" Width="*"/>
                                <DataGridTextColumn Header="Giá/đêm" Binding="{Binding PricePerNight}" Width="100"/>
                                <DataGridTextColumn Header="Đánh giá" Binding="{Binding Rating}" Width="70"/>
                                <DataGridTextColumn Header="Người tạo" Binding="{Binding CreatedByGuide.FullName}" Width="130"/>
                                <DataGridTextColumn Header="Trạng thái"
                                                    Binding="{Binding ApprovalStatus, Converter={StaticResource EnumToVietnameseConverter}}"
                                                    Width="100"/>
                                <DataGridTemplateColumn Header="Thao tác" Width="260">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Sửa"
                                                        Command="{Binding DataContext.EditHotelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Padding="0"/>
                                                <Button Content="Duyệt"
                                                        Command="{Binding DataContext.ApproveHotelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding ApprovalStatus,
                                                            Converter={StaticResource EnumNotEqualConverter},
                                                            ConverterParameter=Approved}"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Foreground="Green" Padding="0" Margin="8,0,0,0"/>
                                                <Button Content="Từ chối"
                                                        Command="{Binding DataContext.RejectHotelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding ApprovalStatus,
                                                            Converter={StaticResource EnumNotEqualConverter},
                                                            ConverterParameter=Rejected}"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Foreground="DarkOrange" Padding="0" Margin="8,0,0,0"/>
                                                <Button Content="Xóa"
                                                        Command="{Binding DataContext.DeleteHotelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Foreground="Red" Padding="0" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <materialDesign:Card Grid.Column="1" Width="350" Padding="20"
                                         Margin="20,0,0,0" VerticalAlignment="Top"
                                         Visibility="{Binding IsHotelEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding HotelFormTitle}"
                                       FontSize="20" FontWeight="SemiBold"
                                       Margin="0,0,0,16"/>
                            <ComboBox ItemsSource="{Binding Destinations}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding HotelDestinationId}"
                                      materialDesign:HintAssist.Hint="Điểm đến"
                                      Margin="0,0,0,10"/>
                            <TextBox Text="{Binding HotelName, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Tên"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Margin="0,0,0,10"/>
                            <TextBox Text="{Binding HotelAddress, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Địa chỉ"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Margin="0,0,0,10"/>
                            <TextBox Text="{Binding HotelDescription, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Mô tả"
                                     AcceptsReturn="True" Height="60"
                                     TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBox Text="{Binding HotelPricePerNight, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Giá mỗi đêm"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Margin="0,0,0,10"/>
                            <TextBox Text="{Binding HotelRating, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Đánh giá (0 - 5)"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Margin="0,0,0,10"/>
                            <Border Height="90" Background="#FFF2F2F2"
                                    BorderBrush="#FFDDDDDD" BorderThickness="1"
                                    CornerRadius="4" Margin="0,0,0,8">
                                <Image Source="{Binding HotelImageUrl}"
                                       Stretch="Uniform"/>
                            </Border>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding HotelImageUrl, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="URL hoặc đường dẫn ảnh"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="Chọn"
                                        Command="{Binding SelectHotelImageCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Hủy"
                                        Command="{Binding CancelHotelEditCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="0,0,8,0"/>
                                <Button Content="Lưu"
                                        Command="{Binding SaveHotelCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <TabItem Header="ĐẶT TOUR">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <Button DockPanel.Dock="Top" Content="Làm mới"
                                Command="{Binding LoadContentDataCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <DataGrid ItemsSource="{Binding Bookings}"
                                  SelectedItem="{Binding SelectedBooking}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã đặt tour" Binding="{Binding BookingId}" Width="110"/>
                                <DataGridTextColumn Header="Người dùng" Binding="{Binding User.FullName}" Width="*"/>
                                <DataGridTextColumn Header="Hướng dẫn viên" Binding="{Binding Guide.FullName}" Width="*"/>
                                <DataGridTextColumn Header="Điểm đến" Binding="{Binding Destination.Name}" Width="*"/>
                                <DataGridTextColumn Header="Khách sạn" Binding="{Binding Hotel.Name}" Width="*"/>
                                <DataGridTextColumn Header="Khởi hành" Binding="{Binding StartDate, StringFormat=d}" Width="90"/>
                                <DataGridTextColumn Header="Số ngày" Binding="{Binding Nights}" Width="60"/>
                                <DataGridTextColumn Header="Trạng thái"
                                                    Binding="{Binding Status, Converter={StaticResource EnumToVietnameseConverter}}"
                                                    Width="110"/>
                                <DataGridTextColumn Header="Yêu cầu hủy"
                                                    Binding="{Binding HasPendingGuideCancellation,
                                                        Mode=OneWay}"
                                                    Width="100"/>
                                <DataGridTextColumn Header="Hoàn tiền"
                                                    Binding="{Binding RefundStatusDisplay}"
                                                    Width="100"/>
                                <DataGridTextColumn Header="Giá" Binding="{Binding Price, StringFormat=N0}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <materialDesign:Card Grid.Column="1" Padding="20"
                                         Margin="20,0,0,0"
                                         VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Quản lý đặt tour"
                                       FontSize="20" FontWeight="SemiBold"
                                       Margin="0,0,0,16"/>
                            <TextBlock Text="Chọn một đặt tour trong bảng."
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding SelectedBooking.BookingId}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedBooking.User.FullName}"
                                       Margin="0,0,0,12"/>
                            <Border Background="#FFFFF3E0"
                                    CornerRadius="5"
                                    Padding="10"
                                    Margin="0,0,0,14"
                                    Visibility="{Binding SelectedBooking.HasPendingGuideCancellation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Hướng dẫn viên yêu cầu hủy"
                                               FontWeight="SemiBold"
                                               Foreground="#FFE65100"/>
                                    <TextBlock Text="{Binding SelectedBooking.GuideCancellationReason}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,4"/>
                                    <TextBlock Text="{Binding SelectedBooking.GuideCancellationRequestedAt, StringFormat=Thời gian yêu cầu: {0:dd/MM/yyyy HH:mm}}"
                                               Foreground="Gray"/>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,10,0,0">
                                        <Button Content="Duyệt hủy"
                                                Command="{Binding ApproveGuideCancellationCommand}"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                Margin="0,0,8,0"/>
                                        <Button Content="Từ chối"
                                                Command="{Binding RejectGuideCancellationCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Background="#FFE8F5E9"
                                    CornerRadius="5"
                                    Padding="10"
                                    Margin="0,0,0,14"
                                    Visibility="{Binding SelectedBooking.HasPendingRefundRequest, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Người dùng yêu cầu hoàn tiền"
                                               FontWeight="SemiBold"
                                               Foreground="#FF2E7D32"/>
                                    <TextBlock Text="{Binding SelectedBooking.RefundReason}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,4"/>
                                    <TextBlock Text="{Binding SelectedBooking.RefundRequestedAt, StringFormat=Thời gian yêu cầu: {0:dd/MM/yyyy HH:mm}}"
                                               Foreground="Gray"/>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,10,0,0">
                                        <Button Content="Duyệt hoàn tiền"
                                                Command="{Binding ApproveRefundCommand}"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                Margin="0,0,8,0"/>
                                        <Button Content="Từ chối"
                                                Command="{Binding RejectRefundCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <ComboBox ItemsSource="{Binding BookingStatuses}"
                                      SelectedItem="{Binding SelectedBookingStatus}"
                                      materialDesign:HintAssist.Hint="Trạng thái mới"
                                      Margin="0,0,0,16"/>
                            <Button Content="Cập nhật trạng thái"
                                    Command="{Binding SaveBookingStatusCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"/>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
