<UserControl x:Class="TravelApp.Views.Admin.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding AdminName, StringFormat=Chào {0}}"
                               FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="Tổng quan hoạt động và các việc cần xử lý"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               FontSize="14" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding LastUpdatedText}"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Làm mới"
                            Command="{Binding LoadDashboardCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0"/>
                    <Button Content="Đăng xuất"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="#FFC62828"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1">
                <ProgressBar IsIndeterminate="True" Height="4"
                             Margin="0,0,0,12"
                             Visibility="{Binding IsLoading,
                                 Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#FFC62828" TextWrapping="Wrap"
                           Margin="0,0,0,12"
                           Visibility="{Binding ErrorMessage,
                               Converter={StaticResource StringToVisibilityConverter}}"/>

                <UniformGrid Columns="4" Rows="2" Margin="-6,0,-6,18">
                    <materialDesign:Card Margin="6" Padding="18">
                        <StackPanel>
                            <TextBlock Text="TÀI KHOẢN" Foreground="#FF5E35B1"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalAccounts}" FontSize="30"
                                       FontWeight="Bold" Margin="0,8,0,2"/>
                            <TextBlock Foreground="{DynamicResource MaterialDesignBodyLight}">
                                <Run Text="{Binding TotalUsers}"/>
                                <Run Text=" Người dùng · "/>
                                <Run Text="{Binding TotalGuides}"/>
                                <Run Text=" Hướng dẫn viên"/>
                            </TextBlock>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Margin="6" Padding="18">
                        <StackPanel>
                            <TextBlock Text="CHỜ DUYỆT NỘI DUNG"
                                       Foreground="#FFEF6C00" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PendingContent}" FontSize="30"
                                       FontWeight="Bold" Margin="0,8,0,2"/>
                            <TextBlock Text="Điểm đến và khách sạn"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Margin="6" Padding="18">
                        <StackPanel>
                            <TextBlock Text="ĐẶT TOUR ĐANG CHỜ"
                                       Foreground="#FF1565C0" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PendingBookings}" FontSize="30"
                                       FontWeight="Bold" Margin="0,8,0,2"/>
                            <TextBlock Text="Chờ hướng dẫn viên phản hồi"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Margin="6" Padding="18">
                        <StackPanel>
                            <TextBlock Text="YÊU CẦU HỦY"
                                       Foreground="#FFC62828" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PendingCancellations}"
                                       FontSize="30" FontWeight="Bold"
                                       Margin="0,8,0,2"/>
                            <TextBlock Text="Đang chờ quản trị viên xử lý"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Margin="6" Padding="18">
                        <StackPanel>
                            <TextBlock Text="TOUR ĐÃ THANH TOÁN"
                                       Foreground="#FF2E7D32" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PaidTours}" FontSize="30"
                                       FontWeight="Bold" Margin="0,8,0,2"/>
                            <TextBlock Text="Bao gồm tour hoàn thành"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Margin="6" Padding="18">
                        <StackPanel>
                            <TextBlock Text="DOANH THU MÔ PHỎNG"
                                       Foreground="#FF00838F" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SimulatedRevenue,
                                      StringFormat={}{0:N0} ₫}"
                                       FontSize="25" FontWeight="Bold"
                                       Margin="0,10,0,2"/>
                            <TextBlock Text="Từ tour đã thanh toán/hoàn thành"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Margin="6" Padding="18"
                                         Grid.ColumnSpan="2">
                        <StackPanel>
                            <TextBlock Text="TRUY CẬP NHANH"
                                       Foreground="#FF5E35B1" FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Quản lý tài khoản"
                                        Command="{Binding NavigateToAccountsCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Margin="0,0,8,0"/>
                                <Button Content="Quản lý nội dung"
                                        Command="{Binding NavigateToContentCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </UniformGrid>
            </StackPanel>

            <materialDesign:Card Grid.Row="2" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Đặt tour cần chú ý" FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Ưu tiên yêu cầu hủy, đặt tour đang chờ và tour đã thanh toán"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Mở quản lý đặt tour"
                                Command="{Binding NavigateToContentCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <TextBlock Text="Không có đặt tour nào cần xử lý."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   Visibility="{Binding HasNoAttentionItems,
                                       Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <DataGrid ItemsSource="{Binding AttentionBookings}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  Visibility="{Binding HasAttentionItems,
                                      Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã đặt tour"
                                                    Binding="{Binding BookingId}"
                                                    Width="130"/>
                                <DataGridTextColumn Header="Người dùng"
                                                    Binding="{Binding User.FullName}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Hướng dẫn viên"
                                                    Binding="{Binding Guide.FullName}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Điểm đến"
                                                    Binding="{Binding DestinationName}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Khởi hành"
                                                    Binding="{Binding StartDate,
                                                        StringFormat=dd/MM/yyyy}"
                                                    Width="110"/>
                                <DataGridTextColumn Header="Trạng thái"
                                                    Binding="{Binding Status, Converter={StaticResource EnumToVietnameseConverter}}"
                                                    Width="110"/>
                                <DataGridCheckBoxColumn Header="Chờ hủy"
                                                        Binding="{Binding HasPendingGuideCancellation,
                                                            Mode=OneWay}"
                                                        Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
