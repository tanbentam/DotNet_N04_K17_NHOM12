<UserControl x:Class="TravelApp.Views.TourGuide.GuideDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Bảng điều khiển Guide"
                           FontSize="26"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Quản lý nội dung, lịch trống và các yêu cầu booking đang chờ xử lý."
                           Foreground="Gray"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Column="1"
                    BorderBrush="#FFE0E0E0"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,8"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AccountTie"
                                             Width="20"
                                             Height="20"
                                             Margin="0,0,8,0"/>
                    <TextBlock Text="Guide"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <TabControl Grid.Row="1"
                    Style="{StaticResource MaterialDesignTabControl}">
            <TabItem Header="NỘI DUNG">
                <Grid Margin="0,16,0,0"
                      DataContext="{Binding DestinationManagementVM}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Điểm đến của tôi"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Nội dung mới hoặc vừa chỉnh sửa sẽ chờ Admin duyệt."
                                       Foreground="Gray"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding LoadDestinationsCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    ToolTip="Tải lại danh sách"
                                    Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="Refresh"/>
                            </Button>
                            <Button Command="{Binding CreateDestinationCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus"
                                                             Margin="0,0,8,0"/>
                                    <TextBlock Text="Thêm điểm đến"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#FFD32F2F"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding SuccessMessage}"
                                   Foreground="#FF2E7D32"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                        <ProgressBar IsIndeterminate="True"
                                     Height="3"
                                     Margin="0,8,0,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid ItemsSource="{Binding Destinations}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  materialDesign:DataGridAssist.CellPadding="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tên"
                                                    Binding="{Binding Name}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Quốc gia"
                                                    Binding="{Binding Country}"
                                                    Width="150"/>
                                <DataGridTextColumn Header="Trạng thái"
                                                    Binding="{Binding ApprovalStatus}"
                                                    Width="110"/>
                                <DataGridTemplateColumn Header="Sửa" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.EditDestinationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    ToolTip="Chỉnh sửa điểm đến"
                                                    Padding="0">
                                                <materialDesign:PackIcon Kind="Pencil"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <materialDesign:Card Grid.Column="1"
                                             Width="360"
                                             Padding="20"
                                             Margin="18,0,0,0"
                                             VerticalAlignment="Top"
                                             Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding FormTitle}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,16"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Tên điểm đến"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         Margin="0,0,0,10"/>
                                <TextBox Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Quốc gia"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         Margin="0,0,0,10"/>
                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Mô tả"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="90"
                                         Margin="0,0,0,10"/>
                                <Border Height="90" Background="#FFF2F2F2"
                                        BorderBrush="#FFDDDDDD" BorderThickness="1"
                                        CornerRadius="4" Margin="0,0,0,8">
                                    <Image Source="{Binding ImageUrl}"
                                           Stretch="Uniform"/>
                                </Border>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ImageUrl, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="URL hoặc đường dẫn ảnh"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="Chọn ảnh"
                                            Command="{Binding SelectImageCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="Hủy"
                                            Command="{Binding CancelEditCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="0,0,8,0"/>
                                    <Button Content="Lưu"
                                            Command="{Binding SaveDestinationCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </materialDesign:Card>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="KHÁCH SẠN">
                <Grid Margin="0,16,0,0"
                      DataContext="{Binding HotelManagementVM}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Khách sạn của tôi"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Khách sạn mới hoặc vừa chỉnh sửa sẽ chờ Admin duyệt."
                                       Foreground="Gray"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding LoadHotelsCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    ToolTip="Tải lại danh sách"
                                    Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="Refresh"/>
                            </Button>
                            <Button Command="{Binding CreateHotelCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus"
                                                             Margin="0,0,8,0"/>
                                    <TextBlock Text="Thêm khách sạn"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#FFD32F2F"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding SuccessMessage}"
                                   Foreground="#FF2E7D32"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                        <ProgressBar IsIndeterminate="True"
                                     Height="3"
                                     Margin="0,8,0,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid ItemsSource="{Binding Hotels}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  materialDesign:DataGridAssist.CellPadding="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tên"
                                                    Binding="{Binding Name}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Điểm đến"
                                                    Binding="{Binding Destination.Name}"
                                                    Width="150"/>
                                <DataGridTextColumn Header="Giá/đêm"
                                                    Binding="{Binding PricePerNight, StringFormat=N0}"
                                                    Width="110"/>
                                <DataGridTextColumn Header="Đánh giá"
                                                    Binding="{Binding Rating}"
                                                    Width="90"/>
                                <DataGridTextColumn Header="Trạng thái"
                                                    Binding="{Binding ApprovalStatus}"
                                                    Width="110"/>
                                <DataGridTemplateColumn Header="Sửa" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.EditHotelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    ToolTip="Chỉnh sửa khách sạn"
                                                    Padding="0">
                                                <materialDesign:PackIcon Kind="Pencil"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <materialDesign:Card Grid.Column="1"
                                             Width="380"
                                             Padding="20"
                                             Margin="18,0,0,0"
                                             VerticalAlignment="Top"
                                             Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding FormTitle}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,16"/>
                                <ComboBox ItemsSource="{Binding Destinations}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding DestinationId}"
                                          materialDesign:HintAssist.Hint="Điểm đến đã duyệt"
                                          Margin="0,0,0,10"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Tên khách sạn"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         Margin="0,0,0,10"/>
                                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Địa chỉ"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         Margin="0,0,0,10"/>
                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Mô tả"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="70"
                                         Margin="0,0,0,10"/>
                                <TextBox Text="{Binding PricePerNight, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Giá mỗi đêm"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         Margin="0,0,0,10"/>
                                <TextBox Text="{Binding Rating, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Đánh giá (0 - 5)"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         Margin="0,0,0,10"/>
                                <Border Height="90" Background="#FFF2F2F2"
                                        BorderBrush="#FFDDDDDD" BorderThickness="1"
                                        CornerRadius="4" Margin="0,0,0,8">
                                    <Image Source="{Binding ImageUrl}"
                                           Stretch="Uniform"/>
                                </Border>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ImageUrl, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="URL hoặc đường dẫn ảnh"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="Chọn ảnh"
                                            Command="{Binding SelectImageCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="Hủy"
                                            Command="{Binding CancelEditCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="0,0,8,0"/>
                                    <Button Content="Lưu"
                                            Command="{Binding SaveHotelCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </materialDesign:Card>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="LỊCH TRỐNG">
                <Grid Margin="0,16,0,0"
                      DataContext="{Binding ScheduleVM}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <materialDesign:Card Grid.Row="0"
                                         Padding="18"
                                         Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CalendarClock"
                                                             Width="24"
                                                             Height="24"
                                                             Margin="0,0,10,0"/>
                                    <TextBlock Text="Đăng ký lịch rảnh trong tuần"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Tick các ngày có thể dẫn tour và nhập khung giờ như 08:00 - 17:00."
                                           Foreground="Gray"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="Lưu lịch"
                                    Command="{Binding SaveScheduleCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0"/>
                        </Grid>
                    </materialDesign:Card>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding WeeklySchedule}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              materialDesign:DataGridAssist.CellPadding="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ngày"
                                                Binding="{Binding DayOfWeek}"
                                                Width="180"
                                                IsReadOnly="True"/>
                            <DataGridCheckBoxColumn Header="Có thể dẫn tour"
                                                    Binding="{Binding IsAvailable}"
                                                    Width="160"/>
                            <DataGridTextColumn Header="Khung giờ"
                                                Binding="{Binding TimeSlot, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="BOOKING">
                <Grid Margin="0,16,0,0"
                      DataContext="{Binding BookingRequestsVM}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <materialDesign:Card Grid.Row="0"
                                         Padding="18"
                                         Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ClipboardList"
                                                             Width="24"
                                                             Height="24"
                                                             Margin="0,0,10,0"/>
                                    <TextBlock Text="Yêu cầu booking chờ xác nhận"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Kiểm tra thông tin khách hàng, điểm đến và quyết định nhận hoặc từ chối yêu cầu."
                                           Foreground="Gray"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="16,0,0,0">
                                <Border Background="#FFFFF3E0"
                                        CornerRadius="6"
                                        Padding="12,8">
                                    <TextBlock Text="Đang chờ"
                                               Foreground="#FFE65100"
                                               FontWeight="SemiBold"/>
                                </Border>
                                <Button Command="{Binding LoadPendingBookingsCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        ToolTip="Tải lại yêu cầu booking"
                                        Margin="8,0,0,0">
                                    <materialDesign:PackIcon Kind="Refresh"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>

                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#FFD32F2F"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                        <ProgressBar IsIndeterminate="True"
                                     Height="3"
                                     Margin="0,8,0,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding PendingBookings}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              materialDesign:DataGridAssist.CellPadding="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã booking" Binding="{Binding BookingId}" Width="120"/>
                            <DataGridTextColumn Header="Khách hàng" Binding="{Binding UserName}" Width="*"/>
                            <DataGridTextColumn Header="Điểm đến" Binding="{Binding DestinationName}" Width="*"/>
                            <DataGridTextColumn Header="Ngày bắt đầu" Binding="{Binding StartDate, StringFormat=d}" Width="120"/>
                            <DataGridTextColumn Header="Số đêm" Binding="{Binding Nights}" Width="80"/>
                            <DataGridTextColumn Header="Giá" Binding="{Binding Price, StringFormat=N0}" Width="110"/>
                            <DataGridTemplateColumn Header="Thao tác" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Nhận"
                                                    Command="{Binding DataContext.AcceptBookingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Foreground="Green"
                                                    Padding="0"/>
                                            <Button Content="Từ chối"
                                                    Command="{Binding DataContext.RejectBookingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Foreground="DarkOrange"
                                                    Padding="0"
                                                    Margin="12,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="LỊCH LÀM VIỆC">
                <Grid Margin="0,16,0,0"
                      DataContext="{Binding WorkScheduleVM}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <materialDesign:Card Grid.Row="0"
                                         Padding="18"
                                         Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CalendarCheck"
                                                             Width="24"
                                                             Height="24"
                                                             Margin="0,0,10,0"/>
                                    <TextBlock Text="Lịch trình làm việc"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Các booking đã chấp nhận hoặc đã thanh toán được sắp xếp theo ngày bắt đầu."
                                           Foreground="Gray"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Command="{Binding LoadWorkScheduleCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    ToolTip="Tải lại lịch làm việc"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0">
                                <materialDesign:PackIcon Kind="Refresh"/>
                            </Button>
                        </Grid>
                    </materialDesign:Card>

                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#FFD32F2F"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                        <ProgressBar IsIndeterminate="True"
                                     Height="3"
                                     Margin="0,8,0,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding WorkSchedule}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              materialDesign:DataGridAssist.CellPadding="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã booking" Binding="{Binding BookingId}" Width="120"/>
                            <DataGridTextColumn Header="Ngày bắt đầu" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="120"/>
                            <DataGridTextColumn Header="Số ngày" Binding="{Binding Nights}" Width="80"/>
                            <DataGridTextColumn Header="Khách hàng" Binding="{Binding UserName}" Width="*"/>
                            <DataGridTextColumn Header="Điểm đến" Binding="{Binding DestinationName}" Width="*"/>
                            <DataGridTextColumn Header="Khách sạn" Binding="{Binding Hotel.Name}" Width="*"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
