<UserControl x:Class="TravelApp.Views.TourGuide.GuideDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource MaterialDesignPaper}">
    <Grid>
        <TabControl Style="{StaticResource MaterialDesignNavigationRailTabControl}" TabStripPlacement="Left">

            <TabItem Header="Điểm Đến &amp; Khách Sạn">
                <Grid Margin="16">
                    <StackPanel>
                        <TextBlock Text="Quản lý Điểm Đến và Khách Sạn" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                        <Button Content="+ Thêm Điểm Đến Mới" Style="{StaticResource MaterialDesignRaisedButton}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                        <TextBlock Text="* Lưu ý: Khách sạn thêm mới cần chờ Admin phê duyệt [cite: 58]" FontStyle="Italic" Foreground="Gray"/>

                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Lịch Trình Đăng Ký">
                <ContentControl Content="{Binding ScheduleVM}" />
            </TabItem>

            <TabItem Header="Yêu Cầu Booking">
                <ContentControl Content="{Binding BookingRequestsVM}" />
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>