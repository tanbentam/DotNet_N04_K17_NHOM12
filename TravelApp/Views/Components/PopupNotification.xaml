<UserControl x:Class="TravelApp.Views.Components.PopupNotification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             IsHitTestVisible="{Binding IsOpen}">
    <Grid Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
        <materialDesign:Card x:Name="NotificationCard"
                             Width="360"
                             Margin="18"
                             Padding="16"
                             Background="#2E7D32"
                             UniformCornerRadius="6">
            <materialDesign:Card.Style>
                <Style TargetType="materialDesign:Card">
                    <Setter Property="Background" Value="#2E7D32"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentNotification.IsError}"
                                     Value="True">
                            <Setter Property="Background" Value="#C62828"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </materialDesign:Card.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Grid.Column="0"
                                         Kind="{Binding CurrentNotification.IconKind}"
                                         Width="26"
                                         Height="26"
                                         Foreground="White"
                                         Margin="0,1,12,0"/>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding CurrentNotification.Title}"
                               FontWeight="Bold"
                               FontSize="15"
                               Foreground="White"/>
                    <TextBlock Text="{Binding CurrentNotification.Message}"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"
                               Foreground="White"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Command="{Binding DismissCommand}"
                        Style="{StaticResource MaterialDesignIconButton}"
                        Foreground="White"
                        Width="32"
                        Height="32"
                        Margin="8,-8,-8,0"
                        ToolTip="Đóng">
                    <materialDesign:PackIcon Kind="Close"/>
                </Button>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
