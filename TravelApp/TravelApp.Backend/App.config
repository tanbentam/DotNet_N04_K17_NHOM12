<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <!-- App.config for TravelApp.Backend
       Instructions:
       1. Install NuGet packages: EntityFramework (6.x) and MySql.Data / MySql.Data.EntityFramework (Connector/NET) and then restore packages.
       2. Update the connection string named "DefaultConnection" with your MySQL server credentials.
       3. Run: Enable-Migrations and Add-Migration InitialCreate (Package Manager Console) or use `update-database` after creating migrations.
  -->
  <connectionStrings>
    <!-- Example MySQL connection string (update credentials):
    <add name="DefaultConnection" connectionString="server=localhost;port=3306;database=travelapp;uid=root;pwd=your_password;" providerName="MySql.Data.MySqlClient" />
    -->
  </connectionStrings>

  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.LocalDbConnectionFactory, EntityFramework">
      <parameters>
        <parameter value="v11.0" />
      </parameters>
    </defaultConnectionFactory>
    <providers>
      <!-- MySQL provider; requires Connector/NET package (MySql.Data.EntityFramework) -->
      <provider invariantName="MySql.Data.MySqlClient" type="MySql.Data.MySqlClient.MySqlProviderServices, MySql.Data.EntityFramework" />
      <!-- SQL Server provider (kept for reference) -->
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>

</configuration>