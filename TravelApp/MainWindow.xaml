<Window x:Class="TravelApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Digital Travel Application"
        Height="720" Width="1280" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#4527A0">
            <Grid Margin="18,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <materialDesign:PackIcon Kind="Airplane" Width="42" Height="42"
                                             Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="TRAVEL APP" Foreground="White" FontSize="22"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                    <TextBlock Text="Explore your next journey" Foreground="#D1C4E9"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,36,0,0">
                    <Button Content="Home" Tag="home" Click="NavigationButton_Click"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                            HorizontalContentAlignment="Left" Height="44"/>
                    <Button Content="Login" Tag="login" Click="NavigationButton_Click"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                            HorizontalContentAlignment="Left" Height="44"/>
                    <Button Content="Register" Tag="register" Click="NavigationButton_Click"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                            HorizontalContentAlignment="Left" Height="44"/>
                    <Separator Margin="0,12" Background="#7E57C2"/>
                    <TextBlock Text="VIEW COMPONENTS" Foreground="#B39DDB" FontSize="11"
                               FontWeight="SemiBold" Margin="12,0,0,8"/>
                    <Button Content="User Dashboard" Tag="user" Click="NavigationButton_Click"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                            HorizontalContentAlignment="Left" Height="44"/>
                    <Button Content="Tour Guide Dashboard" Tag="guide" Click="NavigationButton_Click"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                            HorizontalContentAlignment="Left" Height="44"/>
                    <Button Content="Admin Dashboard" Tag="admin" Click="NavigationButton_Click"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                            HorizontalContentAlignment="Left" Height="44"/>
                    <Button Content="Account Management" Tag="accounts" Click="NavigationButton_Click"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                            HorizontalContentAlignment="Left" Height="44"/>
                    <Button Content="Content Management" Tag="content" Click="NavigationButton_Click"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                            HorizontalContentAlignment="Left" Height="44"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border Background="#352080" CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="DATABASE" Foreground="#B39DDB" FontSize="10"
                                       FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Ellipse x:Name="DatabaseStatusIndicator" Width="9" Height="9"
                                         Fill="#FFC107" Margin="0,0,8,0"/>
                                <TextBlock x:Name="DatabaseStatusText" Text="Checking connection..."
                                           Foreground="White" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Digital Travel Application" Foreground="#D1C4E9"
                               FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0"
                    BorderThickness="0,0,0,1" Padding="28,0">
                <Grid>
                    <TextBlock x:Name="PageTitle" Text="Home" FontSize="24" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="#212121"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentUserText"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"
                                   Visibility="Collapsed"/>
                        <Button x:Name="LogoutButton"
                                Content="Logout"
                                Click="LogoutButton_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,10,0"
                                Visibility="Collapsed"/>
                        <Button Content="Exit" Click="ExitButton_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <ContentControl x:Name="MainContent" Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>
