<Window x:Class="TravelApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:components="clr-namespace:TravelApp.Views.Components"
        Title="Ứng dụng Du lịch Số"
        Height="900" Width="1600" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#4527A0">
            <Grid Margin="18,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <materialDesign:PackIcon Kind="Airplane" Width="42" Height="42"
                                             Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="ỨNG DỤNG DU LỊCH" Foreground="White" FontSize="22"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                    <TextBlock Text="Khám phá hành trình tiếp theo" Foreground="#D1C4E9"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,36,0,0">
                    <Button x:Name="HomeNavButton"
                            Content="Trang chủ" Tag="home" Click="NavigationButton_Click"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                            HorizontalContentAlignment="Left" Height="44"/>
                    <Button x:Name="LoginNavButton"
                            Content="Đăng nhập" Tag="login" Click="NavigationButton_Click"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                            HorizontalContentAlignment="Left" Height="44"/>
                    <Button x:Name="RegisterNavButton"
                            Content="Đăng ký" Tag="register" Click="NavigationButton_Click"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                            HorizontalContentAlignment="Left" Height="44"/>
                    <Separator x:Name="RoleSectionSeparator" Margin="0,12" Background="#7E57C2"/>
                    <TextBlock x:Name="RoleSectionTitle"
                               Text="CHỨC NĂNG" Foreground="#B39DDB" FontSize="11"
                               FontWeight="SemiBold" Margin="12,0,0,8"/>
                    <Button x:Name="UserDashboardNavButton"
                            Content="Bảng điều khiển người dùng" Tag="user" Click="NavigationButton_Click"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                            HorizontalContentAlignment="Left" Height="44"/>
                    <Button x:Name="GuideDashboardNavButton"
                            Content="Bảng điều khiển hướng dẫn viên" Tag="guide" Click="NavigationButton_Click"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                            HorizontalContentAlignment="Left" Height="44"/>
                    <Button x:Name="AdminDashboardNavButton"
                            Content="Bảng điều khiển quản trị" Tag="admin" Click="NavigationButton_Click"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                            HorizontalContentAlignment="Left" Height="44"/>
                    <Button x:Name="AccountManagementNavButton"
                            Content="Quản lý tài khoản" Tag="accounts" Click="NavigationButton_Click"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                            HorizontalContentAlignment="Left" Height="44"/>
                    <Button x:Name="ContentManagementNavButton"
                            Content="Quản lý nội dung" Tag="content" Click="NavigationButton_Click"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                            HorizontalContentAlignment="Left" Height="44"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border Background="#352080" CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="CƠ SỞ DỮ LIỆU" Foreground="#B39DDB" FontSize="10"
                                       FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Ellipse x:Name="DatabaseStatusIndicator" Width="9" Height="9"
                                         Fill="#FFC107" Margin="0,0,8,0"/>
                                <TextBlock x:Name="DatabaseStatusText" Text="Đang kiểm tra kết nối..."
                                           Foreground="White" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Ứng dụng Du lịch Số" Foreground="#D1C4E9"
                               FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0"
                    BorderThickness="0,0,0,1" Padding="28,0">
                <Grid>
                    <TextBlock x:Name="PageTitle" Text="Trang chủ" FontSize="24" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="#212121"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentUserText"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"
                                   Visibility="Collapsed"/>
                        <Button x:Name="LogoutButton"
                                Content="Đăng xuất"
                                Click="LogoutButton_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,10,0"
                                Visibility="Collapsed"/>
                        <Button Content="Thoát" Click="ExitButton_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <ContentControl x:Name="MainContent" Grid.Row="1"/>
        </Grid>

        <components:PopupNotification x:Name="NotificationPopup"
                                      Grid.ColumnSpan="2"
                                      Panel.ZIndex="100"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      Margin="0,72,16,0"/>
    </Grid>
</Window>
