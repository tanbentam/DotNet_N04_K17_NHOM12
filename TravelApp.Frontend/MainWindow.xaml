<Window x:Class="TravelApp.Frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:components="clr-namespace:TravelApp.Frontend.Views.Components"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid>
        <ContentControl Content="{Binding CurrentViewModel}" />

        <components:PopupNotification DataContext="{Binding NotificationManager}"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Right"
                                      Margin="0,20,20,0"
                                      Panel.ZIndex="999" />
    </Grid>
</Window>
