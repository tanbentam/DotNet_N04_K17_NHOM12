<Window x:Class="TravelApp.Frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:components="clr-namespace:TravelApp.Frontend.Views.Components"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="720"
        Width="1280"
        MinHeight="640"
        MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Grid>
        <ContentControl Content="{Binding CurrentView}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Style.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <Border Background="#FFF7ED" Padding="32">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="Startup view is not available."
                                                           FontSize="24"
                                                           FontWeight="SemiBold"
                                                           Foreground="#9A3412"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="MainViewModel.CurrentView is empty."
                                                           Margin="0,12,0,0"
                                                           Foreground="#9A3412"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <components:PopupNotification DataContext="{Binding NotificationManager}"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Right"
                                      Margin="0,20,20,0"
                                      Panel.ZIndex="999" />
    </Grid>
</Window>
