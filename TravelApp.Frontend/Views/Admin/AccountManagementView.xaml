<UserControl x:Class="TravelApp.Frontend.Views.Admin.AccountManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <materialDesign:Card Padding="20"
                             Margin="0,0,20,0"
                             UniformCornerRadius="8">
            <StackPanel>
                <TextBlock Text="Account Form"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16" />

                <TextBox Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Email"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Margin="0,0,0,12" />

                <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Password"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Margin="0,0,0,12" />

                <TextBox Text="{Binding NewPhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Phone number (10 digits)"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Margin="0,0,0,12" />

                <TextBox Text="{Binding NewProvince, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Province/city"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Margin="0,0,0,12" />

                <ComboBox ItemsSource="{Binding AccountRoles}"
                          SelectedItem="{Binding SelectedRole}"
                          materialDesign:HintAssist.Hint="Role"
                          Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                          Margin="0,0,0,18" />

                <Button Content="Create Account"
                        Command="{Binding CreateAccountCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,0,10" />

                <Button Content="Save Selected"
                        Command="{Binding SaveSelectedAccountCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,0,10" />

                <Button Content="Clear"
                        Command="{Binding ClearFormCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}" />

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#0F766E"
                           TextWrapping="Wrap"
                           Margin="0,16,0,0"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}" />
            </StackPanel>
        </materialDesign:Card>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="All Accounts"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <ProgressBar IsIndeterminate="True"
                             Width="120"
                             Margin="18,0,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding UsersList}"
                      SelectedItem="{Binding SelectedUser}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      materialDesign:DataGridAssist.CellPadding="12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*" />
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="*" />
                    <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="*" />
                    <DataGridTextColumn Header="Province/city" Binding="{Binding Province}" Width="*" />
                    <DataGridTemplateColumn Header="Actions" Width="190">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Edit"
                                            Command="{Binding DataContext.LoadSelectedUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignFlatButton}" />
                                    <Button Content="Delete"
                                            Command="{Binding DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Foreground="#B91C1C"
                                            Style="{StaticResource MaterialDesignFlatButton}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
