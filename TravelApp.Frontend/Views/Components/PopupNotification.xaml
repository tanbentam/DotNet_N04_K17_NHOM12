<UserControl x:Class="TravelApp.Frontend.Views.Components.PopupNotification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <materialDesign:Card Margin="10" Padding="16" Width="300"
                         Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
        <materialDesign:Card.Style>
            <Style TargetType="materialDesign:Card">
                <Setter Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentNotification.IsError}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ValidationErrorBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </materialDesign:Card.Style>

        <StackPanel>
            <TextBlock Text="{Binding CurrentNotification.Title}" FontWeight="Bold" FontSize="16" Foreground="White" />
            <TextBlock Text="{Binding CurrentNotification.Message}" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="White"/>
        </StackPanel>
    </materialDesign:Card>
</UserControl>
