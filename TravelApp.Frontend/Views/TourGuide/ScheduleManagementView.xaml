<UserControl x:Class="TravelApp.Frontend.Views.TourGuide.ScheduleManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Weekly Availability"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding WeeklySchedule}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Day" Binding="{Binding DayOfWeek}" Width="*" IsReadOnly="True" />
                <DataGridCheckBoxColumn Header="Available" Binding="{Binding IsAvailable}" Width="*" />
                <DataGridTextColumn Header="Time slot" Binding="{Binding TimeSlot}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2"
                Content="Save Availability"
                Command="{Binding SaveScheduleCommand}"
                HorizontalAlignment="Right"
                Margin="0,18,0,0"
                Style="{StaticResource MaterialDesignRaisedButton}" />
    </Grid>
</UserControl>
