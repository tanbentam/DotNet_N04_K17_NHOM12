<UserControl x:Class="TravelApp.Frontend.Views.TourGuide.GuideDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource MaterialDesignPaper}">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="#1D4ED8"
                Padding="24,14">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="Tour Guide Workspace"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Manage destination content, hotels, availability, and booking requests."
                               Foreground="#EAF1FF" />
                </StackPanel>

                <Button Content="Logout"
                        Command="{Binding LogoutCommand}"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="White"
                        BorderBrush="White" />
            </DockPanel>
        </Border>

        <TabControl Style="{StaticResource MaterialDesignTabControl}">
            <TabItem Header="Destinations &amp; Hotels">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Add Destination"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Margin="0,0,12,0" />
                        <Button Content="Add Hotel"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="API INTEGRATION POINT: guide content CRUD will connect to destination and hotel endpoints. New hotels require admin approval before public listing."
                               Margin="0,20,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                </Grid>
            </TabItem>

            <TabItem Header="Availability">
                <ContentControl Content="{Binding ScheduleManagementViewModel}" />
            </TabItem>

            <TabItem Header="Booking Requests">
                <ContentControl Content="{Binding BookingRequestsViewModel}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
