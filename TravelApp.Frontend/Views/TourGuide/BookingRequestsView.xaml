<UserControl x:Class="TravelApp.Frontend.Views.TourGuide.BookingRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Incoming Booking Requests"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding PendingBookings}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Booking" Binding="{Binding BookingId}" Width="*" />
                <DataGridTextColumn Header="Customer" Binding="{Binding UserName}" Width="*" />
                <DataGridTextColumn Header="Destination" Binding="{Binding DestinationName}" Width="*" />
                <DataGridTextColumn Header="Hotel" Binding="{Binding HotelName}" Width="*" />
                <DataGridTemplateColumn Header="Decision" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Accept"
                                        Command="{Binding DataContext.AcceptBookingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}" />
                                <Button Content="Reject"
                                        Command="{Binding DataContext.RejectBookingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Foreground="#B91C1C"
                                        Style="{StaticResource MaterialDesignFlatButton}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
