<UserControl x:Class="TravelApp.Frontend.Views.TourGuide.GuideContentManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <materialDesign:Card Padding="20"
                             Margin="0,0,20,0"
                             UniformCornerRadius="8">
            <StackPanel>
                <TextBlock Text="Guide Content Form"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16" />

                <ComboBox ItemsSource="{Binding ContentTypes}"
                          SelectedItem="{Binding SelectedContentType}"
                          materialDesign:HintAssist.Hint="Content type"
                          Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                          Margin="0,0,0,12" />

                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Name"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Margin="0,0,0,12" />

                <TextBox Text="{Binding Province, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Province/city"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Margin="0,0,0,12" />

                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Hotel address"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Margin="0,0,0,12" />

                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Destination description"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Height="90"
                         Margin="0,0,0,12" />

                <TextBox Text="{Binding ImageUrl, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Image URL or uploaded image path"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Margin="0,0,0,12" />

                <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Guide price / hotel price"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Margin="0,0,0,12" />

                <TextBox Text="{Binding Rating, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Rating"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Margin="0,0,0,18" />

                <Button Content="Save Content"
                        Command="{Binding SaveContentCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,0,10" />

                <Button Content="Clear"
                        Command="{Binding ClearFormCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}" />

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#1D4ED8"
                           TextWrapping="Wrap"
                           Margin="0,16,0,0"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}" />
            </StackPanel>
        </materialDesign:Card>

        <TabControl Grid.Column="1"
                    Style="{StaticResource MaterialDesignTabControl}">
            <TabItem Header="Destinations">
                <DataGrid ItemsSource="{Binding Destinations}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Province" Binding="{Binding Province}" Width="*" />
                        <DataGridTextColumn Header="Rating" Binding="{Binding Rating}" Width="*" />
                        <DataGridTextColumn Header="Guide price" Binding="{Binding GuidePriceFrom}" Width="*" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*" />
                        <DataGridTemplateColumn Header="Actions" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Edit"
                                                Command="{Binding DataContext.LoadDestinationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}" />
                                        <Button Content="Delete"
                                                Command="{Binding DataContext.DeleteDestinationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Foreground="#B91C1C"
                                                Style="{StaticResource MaterialDesignFlatButton}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Hotels">
                <DataGrid ItemsSource="{Binding Hotels}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Province" Binding="{Binding Province}" Width="*" />
                        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="2*" />
                        <DataGridTextColumn Header="Price/night" Binding="{Binding PricePerNight}" Width="*" />
                        <DataGridTextColumn Header="Rating" Binding="{Binding Rating}" Width="*" />
                        <DataGridCheckBoxColumn Header="Approved" Binding="{Binding IsApproved}" Width="*" />
                        <DataGridTemplateColumn Header="Actions" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Edit"
                                                Command="{Binding DataContext.LoadHotelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}" />
                                        <Button Content="Delete"
                                                Command="{Binding DataContext.DeleteHotelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Foreground="#B91C1C"
                                                Style="{StaticResource MaterialDesignFlatButton}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
