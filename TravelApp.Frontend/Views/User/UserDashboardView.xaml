<UserControl x:Class="TravelApp.Frontend.Views.User.UserDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource MaterialDesignPaper}">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="#0F766E"
                Padding="24,14">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="Customer Workspace"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Search destinations, book guides, choose hotels, and simulate payment."
                               Foreground="#D9FFF9" />
                </StackPanel>

                <Button Content="Logout"
                        Command="{Binding LogoutCommand}"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="White"
                        BorderBrush="White" />
            </DockPanel>
        </Border>

        <TabControl Style="{StaticResource MaterialDesignTabControl}">
            <TabItem Header="Search">
                <ContentControl Content="{Binding AdvancedSearchViewModel}" />
            </TabItem>

            <TabItem Header="Book Tour">
                <ContentControl Content="{Binding TourBookingViewModel}" />
            </TabItem>

            <TabItem Header="Payment">
                <ContentControl Content="{Binding PaymentSimulationViewModel}" />
            </TabItem>

            <TabItem Header="Wishlist &amp; Reviews">
                <Grid Margin="24">
                    <TextBlock Text="Wishlist and rating/review screens will connect to favorites, guide ratings, hotel reviews, and destination ratings APIs."
                               TextWrapping="Wrap"
                               FontSize="16" />
                </Grid>
            </TabItem>

            <TabItem Header="Profile">
                <Grid Margin="24">
                    <TextBlock Text="Profile management will bind to the authenticated user's editable email, phone number, and province/city."
                               TextWrapping="Wrap"
                               FontSize="16" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
